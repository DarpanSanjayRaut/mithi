# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# FalkorDB connection. Local docker: falkor://localhost:6379
# FalkorDB Cloud: falkor://<user>:<password>@<host>:<port>
FALKORDB_URL=falkor://localhost:6379

# Optional model overrides
# MITHI_COMPANION_MODEL=claude-opus-5-5
# MITHI_EXTRACT_MODEL=claude-haiku-4-5
